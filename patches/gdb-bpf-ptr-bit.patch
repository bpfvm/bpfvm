diff --git a/gdb/bpf-tdep.c b/gdb/bpf-tdep.c
index 2459ba45..42812e7c 100644
--- a/gdb/bpf-tdep.c
+++ b/gdb/bpf-tdep.c
@@ -306,7 +306,25 @@ bpf_return_value (struct gdbarch *gdbarch, struct value *function,
   return RETURN_VALUE_REGISTER_CONVENTION;
 }
 
-
+/* Provide a syscall-number hook so GDB's "catch syscall" feature gate
+   (gdbarch_get_syscall_number_p, checked in catch_syscall_command) is
+   satisfied; without it GDB rejects the feature with "not supported on this
+   architecture yet" before ever consulting the remote stub, even though the
+   stub's syscall_entry/syscall_return stop reasons already carry the syscall
+   number.  On the remote path GDB takes the number from the stop reply, not
+   from this hook, so the returned value (r1, the first syscall argument
+   under musl's __syscall ABI) is only a placeholder.  */
+
+static LONGEST
+bpf_get_syscall_number (struct gdbarch *gdbarch, thread_info *thread)
+{
+  regcache *regcache = get_thread_regcache (thread);
+  ULONGEST sysno = 0;
+  regcache->cooked_read (BPF_R1_REGNUM, &sysno);
+  return (LONGEST) sysno;
+}
+
+
 /* Initialize the current architecture based on INFO.  If possible, reuse an
    architecture from ARCHES, which is a list of architectures already created
    during this debugging session.  */
@@ -323,6 +341,18 @@ bpf_gdbarch_init (struct gdbarch_info info, struct gdbarch_list *arches)
   gdbarch *gdbarch
     = gdbarch_alloc (&info, gdbarch_tdep_up (new bpf_gdbarch_tdep));
 
+  /* BPF is a 64-bit ISA.  Without these, builtin_data_ptr / builtin_func_ptr
+     (returned by bpf_register_type for r10/pc) default to 32-bit, so the
+     g-packet lays them out as 4 bytes while unwinders read SP/PC as 8 bytes;
+     the first raw_read after a backtrace then fails the
+     "dst.size () == sizeof_register[regnum]" assertion.  */
+  set_gdbarch_short_bit (gdbarch, 16);
+  set_gdbarch_int_bit (gdbarch, 32);
+  set_gdbarch_long_bit (gdbarch, 64);
+  set_gdbarch_long_long_bit (gdbarch, 64);
+  set_gdbarch_ptr_bit (gdbarch, 64);
+  set_gdbarch_addr_bit (gdbarch, 64);
+
   /* Information about registers, etc.  */
   set_gdbarch_num_regs (gdbarch, BPF_NUM_REGS);
   set_gdbarch_register_name (gdbarch, bpf_register_name);
@@ -343,6 +373,19 @@ bpf_gdbarch_init (struct gdbarch_info info, struct gdbarch_list *arches)
   /* Returning results.  */
   set_gdbarch_return_value (gdbarch, bpf_return_value);
 
+  /* Enable "catch syscall": the hook flips gdbarch_get_syscall_number_p so
+     GDB no longer rejects the feature; the actual number on the remote path
+     comes from the stop reply.  */
+  set_gdbarch_get_syscall_number (gdbarch, bpf_get_syscall_number);
+  /* BPF uses its own (non-Linux) syscall numbers, so no upstream syscall
+     XML applies.  Setting a (nonexistent) filename avoids GDB's bug where
+     a NULL xml_syscall_file + enabled syscall catch makes xml_fetch_content
+     open the datadir as a file and allocate a multi-ExB char_vector from a
+     bogus ftell, aborting with std::length_error.  With a real-looking name
+     gdb_fopen fails cleanly (file not found) and catch syscall works with
+     numbers only.  */
+  set_gdbarch_xml_syscall_file (gdbarch, "bpf-linux.xml");
+
   /* Advance PC across function entry code.  */
   set_gdbarch_skip_prologue (gdbarch, bpf_skip_prologue);
 
@@ -362,6 +405,13 @@ bpf_gdbarch_init (struct gdbarch_info info, struct gdbarch_list *arches)
   /* Hook in ABI-specific overrides, if they have been registered.  */
   gdbarch_init_osabi (info, gdbarch);
 
+  /* Register the DWARF CFI frame unwinder BEFORE the default bpf prologue
+     unwinder.  Upstream bpf_frame_unwind is a stub (bpf_frame_this_id is
+     empty, stop_reason returns UNWIND_OUTERMOST), so backtrace never walks
+     past frame #0.  dwarf2_frame_sniffer only claims frames whose PC has an
+     FDE, so frames without CFI still fall through to bpf_frame_unwind.  */
+  dwarf2_append_unwinders (gdbarch);
+
   /* Install unwinders.  */
   frame_unwind_append_unwinder (gdbarch, &bpf_frame_unwind);
 
