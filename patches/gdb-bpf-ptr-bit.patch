diff --git a/gdb/bpf-tdep.c b/gdb/bpf-tdep.c
index 2459ba45..03596fed 100644
--- a/gdb/bpf-tdep.c
+++ b/gdb/bpf-tdep.c
@@ -323,6 +323,18 @@ bpf_gdbarch_init (struct gdbarch_info info, struct gdbarch_list *arches)
   gdbarch *gdbarch
     = gdbarch_alloc (&info, gdbarch_tdep_up (new bpf_gdbarch_tdep));
 
+  /* BPF is a 64-bit ISA.  Without these, builtin_data_ptr / builtin_func_ptr
+     (returned by bpf_register_type for r10/pc) default to 32-bit, so the
+     g-packet lays them out as 4 bytes while unwinders read SP/PC as 8 bytes;
+     the first raw_read after a backtrace then fails the
+     "dst.size () == sizeof_register[regnum]" assertion.  */
+  set_gdbarch_short_bit (gdbarch, 16);
+  set_gdbarch_int_bit (gdbarch, 32);
+  set_gdbarch_long_bit (gdbarch, 64);
+  set_gdbarch_long_long_bit (gdbarch, 64);
+  set_gdbarch_ptr_bit (gdbarch, 64);
+  set_gdbarch_addr_bit (gdbarch, 64);
+
   /* Information about registers, etc.  */
   set_gdbarch_num_regs (gdbarch, BPF_NUM_REGS);
   set_gdbarch_register_name (gdbarch, bpf_register_name);
