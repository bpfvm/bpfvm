#!/bin/bash
set -e

compile_only=0
out=""
src=""
expect_out=0

for arg in "$@"; do
    if [ "$expect_out" -eq 1 ]; then
        out="$arg"
        expect_out=0
        continue
    fi
    case "$arg" in
        -c)
            compile_only=1
            ;;
        -o)
            expect_out=1
            ;;
        -o*)
            out="${arg#-o}"
            ;;
        *.c|*.cc|*.cpp|*.cxx|*.S|*.s)
            src="$arg"
            ;;
    esac
done

clang "$@"

if [ "$compile_only" -eq 1 ]; then
    if [ -z "$out" ] && [ -n "$src" ]; then
        out="${src%.*}.o"
    fi
    if [ -n "$out" ] && [ -f "$out" ]; then
        if bpf-readelf -S "$out" 2>/dev/null | grep -q '\.rodata\.str1\.1'; then
            bpf-objcopy --set-section-flags .rodata.str1.1=alloc,readonly,data "$out"
        fi
    fi
fi
